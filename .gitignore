# 가상환경
venv/
.venv/

# 환경변수·비밀정보
.env
.env.*
!.env.example

# Python 실행 캐시
__pycache__/
*.py[cod]

# 테스트·커버리지 결과
.pytest_cache/
.coverage
htmlcov/

# 로컬 SQLite 데이터와 관련 파일
*.db
*.db-journal
*.db-wal
*.db-shm

# DB 백업
backups/

# 실행 로그
*.log

# DOM 테스트 도구 (제품 화면에는 JavaScript 라이브러리를 사용하지 않음)
node_modules/
