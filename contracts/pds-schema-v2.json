  "rules": {
    "plan_dates": "end_date >= start_date enforced by request schemas",
    "plan_history": "each successful PUT snapshots the previous Plan; current Plan is not a history row; no history restore API",
    "task_completion": "repeat complete preserves completed_at and creates no Execution; reopen clears completed_at",
    "task_delete": "API transaction deletes TaskLinks, Executions, then Task; failure rolls back; other records preserved",
    "plan_delete": "no API; no configured ON DELETE CASCADE",
    "daily_note": "one row per date; PUT replaces content; empty string allowed; unwritten GET returns null",
    "review": "one row per Plan; PUT replaces fields; omitted fields become null",
    "next_plan": "creates a Plan with saved improvement/action appended to description and links Review; duplicate link rejected",
    "summary_scope": "Tasks in selected Plan; optional start_date/end_date inclusively filter Task.scheduled_date; omitted bounds are open; default is all Tasks",
    "summary_period_executions": "all Executions linked to selected Tasks regardless of execution date; completion is current status, overdue is evaluated against server today, not a historical snapshot",
    "summary_period_api": "GET /tasks, /plans/{plan_id}/summary and /plans/{plan_id}/executions share optional YYYY-MM-DD start_date/end_date; invalid or reversed dates return 422; no schema migration",
    "overdue": "status != DONE and due_date < server today",
    "blocked": "distinct Task IDs with any Execution blocked_reason.strip() nonempty, including DONE Tasks",
    "expected_minutes": "sum Task.expected_minutes, not Plan.expected_minutes",
    "actual_minutes": "sum associated Execution.actual_minutes, null treated as zero",
    "empty_summary": "counts and minute sums zero; completion_rate zero",
    "validation": "API validation and DB null/foreign key/unique constraints are distinct; ge=0 and title length are request validation, not DB CHECK constraints",
    "export": "GET /export returns all seven tables sorted by ID as planner-export.json; no import endpoint",
    "migration": "create_all creates missing tables but does not add columns to existing tables; older executions tables may need blocked_reason TEXT after backup"
  },
  "export_keys": [
    "plans",
    "plan_versions",
    "tasks",
    "task_links",
    "executions",
    "reviews",
    "daily_notes"
  ]
}
